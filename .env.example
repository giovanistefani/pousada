# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave anon (legada) ou publishable. Nunca use a service role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo. Sem prefixo NEXT_PUBLIC_. Usado só no webhook de pagamento e no feed iCal.
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo valor configurado no gateway (Asaas, Mercado Pago ou Stripe).
PAYMENT_WEBHOOK_SECRET=

# Token da URL /api/ical/[roomId]?token=...
ICAL_FEED_SECRET=
